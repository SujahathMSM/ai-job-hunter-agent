# AI Provider Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External Job Search & HR Finding APIs (Optional Free Tiers)
RAPIDAPI_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=

# Outbound Email Dispatcher (Optional - for live sending)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_NAME=Engineering Candidate

# Safety Mode: True = Save .eml drafts; False = Send live to HR
SAFE_MODE=True

# Authentication
# ALLOW_DEV_AUTH=true lets this machine (loopback only) use the app without signing in.
# Leave false/unset anywhere the server is reachable by other people.
# ALLOW_DEV_AUTH=true
# Required when APP_ENV=production (32+ random characters). If unset locally, a random
# secret is generated and stored in data/.jwt_secret.
JWT_SECRET=
APP_ENV=
