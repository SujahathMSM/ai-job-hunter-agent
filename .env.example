# AI Provider Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides (defaults: gemini-2.5-flash then gemini-flash-lite-latest, gpt-4o-mini, claude-opus-5-5)
# GEMINI_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# Seconds to wait for an LLM response before trying the next provider
# LLM_TIMEOUT_SECONDS=120

# External Job Search & HR Finding APIs (Optional Free Tiers)
RAPIDAPI_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=

# Outbound Email Dispatcher (Optional - for live sending)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_NAME=Engineering Candidate

# Safety Mode: True = Save .eml drafts; False = Send live to HR
SAFE_MODE=True

# Authentication
# ALLOW_DEV_AUTH=true lets this machine (loopback only) use the app without signing in.
# Leave false/unset anywhere the server is reachable by other people.
# ALLOW_DEV_AUTH=true
# Required when APP_ENV=production (32+ random characters). If unset locally, a random
# secret is generated and stored in data/.jwt_secret.
JWT_SECRET=
APP_ENV=
# Encrypts stored SMTP passwords. Required when APP_ENV=production. If unset locally,
# a key is generated in data/.data_key. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
